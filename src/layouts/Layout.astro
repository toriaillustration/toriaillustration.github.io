---
import '../styles/style.css'

const {
  title = "",
  hero = false,
  heroTitle = "",
  heroSubTitle = ""
} = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Illustration', href: '/illustration' },
  { label: 'Concept Art', href: '/concept-art' },
  { label: 'Storyboarding', href: '/storyboarding' },
  { label: '2D Animation', href: '/2d-animation' },
  { label: 'About me', href: '/about-me' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const linkIsActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    	<title>{[title, 'Victoria Todd'].filter(Boolean).join(' - ')}</title>
	</head>
	<body class="font-serif min-h-screen">
		<header class="sticky top-0 z-50">
			<div class="mx-auto flex-col max-w-6xl flex-wrap items-center justify-between gap-4 px-4 pt-8 pb-8 md:flex-nowrap">
				<a class="flex flex-row justify-center items-center gap-3 mb-10" href="/">
					<img
						src="/ladybird.svg"
						alt="Ladybird"
						class="h-20 mr-2 w-auto max-w-[100px]"
						loading="lazy"
					/>
					<p class="text-5xl">Victoria Todd</p>
				</a>
				<nav class="hidden gap-6 text-md md:flex md:flex-1 md:gap-20 md:justify-center">
					{navLinks.map((link) => (
						<a class:list={[
							'transition-colors hover:text-red-600 text-xl',
							linkIsActive(link.href) ? 'font-semibold text-red-600' : ''
						]}
						href={link.href}
						>
						{link.label}
						</a>
					))}
				</nav>
				<button class="text-3xl text-black md:hidden" aria-label="Open navigation" onclick="document.querySelector('nav.mobile-menu')?.classList.toggle('hidden')">
					<span class="sr-only">Menu</span>
					&#9776;
				</button>
			</div>
			<nav class="mobile-menu hidden border-t border-white/10 bg-white px-4 pt-4 pb-6 text-sm text-black md:hidden">
				<div class="flex flex-col gap-3">
				{navLinks.map((link) => (
					<a
					class:list=[
						'transition-colors hover:text-red-600',
						linkIsActive(link.href) ? 'font-semibold text-white' : ''
					]
					href={link.href}
					>
					{link.label}
					</a>
				))}
				</div>
			</nav>
		</header>
		<main class:list={[hero ? 'pt-0' : 'pt-6 mx-auto max-w-8xl']}>
			{hero && (
				<div class="mb-4 pt-10 pb-20 bg-[url('/hero.svg')] bg-[#9F0000] bg-bottom bg-no-repeat text-center">
					<h1 class="text-4xl my-5 text-white">{heroTitle}</h1>
					<p class="text-2xl my-5 text-white">{heroSubTitle}</p>
				</div>
			)}
			<div class="px-10">	
				<slot />
			</div>
		</main>
		<footer class="mt-16 bg-[url('/footer.svg')] bg-top bg-no-repeat">
			<div class="mx-auto grid max-w-8xl gap-10 px-10 pt-20 pb-12 md:grid-cols-2">
				<div class="space-y-4">
					<div class="flex items-center gap-3 text-white">
						<img src="/ladybird.svg" alt="Ladybird" class="h-20 w-auto" loading="lazy" />
						<div>
							<p class="text-4xl mb-2">Victoria Todd</p>
							<p style="text-white"><a href="mailto:contact@toriatodd.co.uk">contact@toriatodd.co.uk</a></p>
						</div>
					</div>
				</div>
			</div>
			<div class="px-4 pb-3 text-center text-xs text-white">
				© {new Date().getFullYear()} Victoria Todd. All rights reserved.
			</div>
		</footer>
	</body>
</html>
